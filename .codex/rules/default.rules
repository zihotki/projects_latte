# Read-only Git inspection.
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "ls-files", "rev-parse"]],
    decision = "allow",
    justification = "Routine repository inspection is safe in this trusted repository",
    match = [
        "git status --short",
        "git diff --check",
        "git log --oneline -10",
        "git show --stat HEAD",
        "git ls-files",
        "git rev-parse --show-toplevel",
    ],
    not_match = [
        "git reset --hard",
        "git restore .",
        "git push",
    ],
)

# Local Git index and commit operations. Networked and destructive Git commands
# intentionally remain approval-gated.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging in-scope repository changes is routine local work",
    match = [
        "git add AGENTS.md",
        "git add cut_on_eight/apps/web/src/App.svelte",
    ],
    not_match = [
        "git push",
        "git reset --hard",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Creating local commits is routine work in this repository",
    match = [
        "git commit -m \"refactor: organize frontend state\"",
    ],
    not_match = [
        "git push",
    ],
)

# Repository-owned package scripts are the public command interface. Dependency
# installation, arbitrary pnpm exec, and direct binary commands remain gated.
prefix_rule(
    pattern = [
        "pnpm",
        "-C",
        "cut_on_eight",
        [
            "verify",
            "dev",
            "test:web",
            "test:server",
            "test:contracts",
            "check:web",
            "format:file",
            "svelte:fix",
        ],
    ],
    decision = "allow",
    justification = "The documented Cut on Eight command interface is trusted",
    match = [
        "pnpm -C cut_on_eight verify",
        "pnpm -C cut_on_eight dev",
        "pnpm -C cut_on_eight test:web",
        "pnpm -C cut_on_eight test:web apps/web/src/app/app-model.test.ts",
        "pnpm -C cut_on_eight test:server",
        "pnpm -C cut_on_eight test:contracts",
        "pnpm -C cut_on_eight check:web",
        "pnpm -C cut_on_eight format:file apps/web/src/App.svelte",
        "pnpm -C cut_on_eight svelte:fix apps/web/src/App.svelte",
    ],
    not_match = [
        "pnpm -C cut_on_eight install",
        "pnpm -C cut_on_eight add svelte",
        "pnpm -C cut_on_eight exec sh",
        "node_modules/.bin/prettier --write cut_on_eight/apps/web/src/App.svelte",
        "node_modules/.bin/svelte-mcp svelte-autofixer cut_on_eight/apps/web/src/App.svelte",
    ],
)
