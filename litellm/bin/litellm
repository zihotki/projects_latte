#!/usr/bin/env bash
set -euo pipefail
set +x

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LITELLM_COMPOSE_FILE="$project_dir/compose.yaml"
source "$project_dir/lib/backup.sh"

usage() {
  printf 'Usage: %s start [--reinitialize-backup-repo]|status|backup|stop|restore-check [--expect-key-alias ALIAS]\n' "$0" >&2
  exit 2
}

compose() {
  docker compose -f "$LITELLM_COMPOSE_FILE" "$@"
}

require_docker() {
  command -v docker >/dev/null || { printf 'Docker is not installed.\n' >&2; return 1; }
  docker info >/dev/null 2>&1 || { printf 'Docker daemon is unavailable.\n' >&2; return 1; }
}

acquire_lock() {
  local lock_dir="$project_dir/../.local/litellm"
  mkdir -p -m 700 "$lock_dir"
  [[ "$(stat -f '%u' "$lock_dir" 2>/dev/null || stat -c '%u' "$lock_dir")" == "$(id -u)" ]] || {
    printf 'LiteLLM lock directory is not owned by you.\n' >&2; return 1;
  }
  # flock locks the shared open file description. The Bash process keeps it
  # open after Python exits, until the command and its cleanup have finished.
  exec 9> "$lock_dir/session.lock"
  python3 - 9 <<'PY'
import fcntl
import sys
fcntl.flock(int(sys.argv[1]), fcntl.LOCK_EX)
PY
}

live_volume_exists() {
  local volume
  volume="$(compose config --format json | python3 -c 'import json,sys; print(json.load(sys.stdin)["volumes"]["postgres-data"]["name"])')" || return 1
  docker volume inspect "$volume" >/dev/null 2>&1
}

resolve_backup_dir() {
  local create="${1:-no}"
  local backup_dir="${LITELLM_BACKUP_DIR:-$HOME/.local/share/projectslatte/litellm-backups}"
  [[ "$backup_dir" = /* ]] || { printf 'Backup path must be absolute.\n' >&2; return 1; }
  if [[ "$create" == yes ]]; then
    mkdir -p -m 700 "$backup_dir" || { printf 'Cannot create backup directory.\n' >&2; return 1; }
  fi
  [[ -d "$backup_dir" ]] || { printf 'Backup repository directory is missing: %s\n' "$backup_dir" >&2; return 1; }
  LITELLM_BACKUP_DIR="$(cd "$backup_dir" && pwd -P)" || return 1
  export LITELLM_BACKUP_DIR
  local mode owner
  mode="$(stat -f '%Lp' "$LITELLM_BACKUP_DIR" 2>/dev/null || stat -c '%a' "$LITELLM_BACKUP_DIR")" || return 1
  owner="$(stat -f '%u' "$LITELLM_BACKUP_DIR" 2>/dev/null || stat -c '%u' "$LITELLM_BACKUP_DIR")" || return 1
  [[ "$owner" == "$(id -u)" && "$mode" == 700 ]] || {
    printf 'Backup directory must be owned by you and have mode 700: %s\n' "$LITELLM_BACKUP_DIR" >&2
    return 1
  }
}

require_writable_backup_dir() {
  [[ -w "$LITELLM_BACKUP_DIR" ]] || { printf 'Backup directory is not writable.\n' >&2; return 1; }
  local probe="$LITELLM_BACKUP_DIR/.write-check-$$"
  ( umask 077; : > "$probe" ) || { printf 'Backup directory is not writable.\n' >&2; return 1; }
  rm -f "$probe"
}

repository_has_metadata() {
  [[ -f "$LITELLM_BACKUP_DIR/backup/litellm/backup.info" && -f "$LITELLM_BACKUP_DIR/archive/litellm/archive.info" ]]
}

repository_is_empty() {
  [[ -z "$(find "$LITELLM_BACKUP_DIR" -mindepth 1 -print -quit)" ]]
}

is_running() {
  [[ -n "$(compose ps --status running -q "$1")" ]]
}

running_backup_dir() {
  local postgres_id
  postgres_id="$(compose ps --status running -q postgres)"
  [[ -n "$postgres_id" ]] || { printf 'PostgreSQL is not running.\n' >&2; return 1; }
  docker inspect --format '{{json .Mounts}}' "$postgres_id" | python3 -c '
import json
import os
import sys

mounts = json.load(sys.stdin)
sources = [m.get("Source") for m in mounts if m.get("Type") == "bind" and m.get("Destination") == "/var/lib/pgbackrest"]
if len(sources) != 1 or not sources[0]:
    print("Running PostgreSQL has no unique backup repository bind mount.", file=sys.stderr)
    sys.exit(1)
source = sources[0]
if sys.platform == "darwin" and source.startswith("/host_mnt/"):
    source = source[len("/host_mnt"):]
print(os.path.realpath(source))
'
}

require_matching_backup_dir() {
  local mounted_dir
  mounted_dir="$(running_backup_dir)" || return 1
  [[ "$mounted_dir" == "$LITELLM_BACKUP_DIR" ]] || {
    printf 'Backup directory differs from the running PostgreSQL mount: %s\n' "$mounted_dir" >&2
    return 1
  }
}

wait_postgres() {
  local i
  for ((i=0; i<90; i++)); do
    if [[ "$(compose ps --format json postgres 2>/dev/null | python3 -c 'import json,sys; text=sys.stdin.read().strip(); print(any(c.get("Health") == "healthy" for c in ([json.loads(x) for x in text.splitlines()] if text else [])))' 2>/dev/null)" == True ]]; then
      return 0
    fi
    is_running postgres || break
    sleep 2
  done
  printf 'PostgreSQL did not become healthy.\n' >&2
  return 1
}

wait_proxy() {
  local i
  for ((i=0; i<90; i++)); do
    if curl --silent --show-error --fail --max-time 2 http://127.0.0.1:4000/health/liveliness >/dev/null 2>&1; then
      return 0
    fi
    is_running proxy || break
    sleep 2
  done
  printf 'LiteLLM did not become ready. Check docker compose logs proxy.\n' >&2
  return 1
}

start() {
  local reinitialize="${1:-no}"
  require_docker
  if is_running proxy; then
    [[ "$reinitialize" == no ]] || { printf 'Stop the gateway before reinitializing its backup repository.\n' >&2; return 1; }
    LITELLM_BACKUP_DIR="$(running_backup_dir)" || return 1
    resolve_backup_dir
    repository_has_metadata || { printf 'Backup repository is missing or incomplete.\n' >&2; return 1; }
    printf 'LiteLLM is already running.\n'
    return 0
  fi
  source "$project_dir/lib/secrets.sh"
  local volume_exists=0 create_stanza=0
  if live_volume_exists; then volume_exists=1; fi
  if [[ "$reinitialize" == yes ]]; then
    (( volume_exists )) || { printf 'No live database volume exists; reinitialization is unnecessary.\n' >&2; return 1; }
    is_running postgres && { printf 'Stop PostgreSQL before reinitializing the backup repository.\n' >&2; return 1; }
    resolve_backup_dir yes
    repository_is_empty || { printf 'Backup repository is not empty; preserve it before reinitialization.\n' >&2; return 1; }
    create_stanza=1
  else
    if (( volume_exists )); then resolve_backup_dir; else resolve_backup_dir yes; fi
    if repository_has_metadata; then
      :
    elif (( volume_exists )) || ! repository_is_empty; then
      printf 'Backup repository is missing or incomplete. Restore it, or see the explicit reinitialization guide.\n' >&2
      return 1
    else
      create_stanza=1
    fi
  fi
  require_writable_backup_dir
  local postgres_before proxy_before postgres_was_running=0 success=0
  postgres_before="$(compose ps -aq postgres)"
  proxy_before="$(compose ps -aq proxy)"
  if is_running postgres; then
    postgres_was_running=1
    require_matching_backup_dir
  fi
  cleanup_start() {
    if (( success == 0 )); then
      if [[ -z "$proxy_before" ]]; then compose rm --stop --force proxy >/dev/null 2>&1 || true
      else compose stop proxy >/dev/null 2>&1 || true; fi
      if (( postgres_was_running == 0 )); then
        if [[ -z "$postgres_before" ]]; then compose rm --stop --force postgres >/dev/null 2>&1 || true
        else compose stop postgres >/dev/null 2>&1 || true; fi
      fi
    fi
  }
  trap cleanup_start EXIT
  compose up -d --no-deps postgres
  wait_postgres
  if (( create_stanza )); then
    compose exec -T --user postgres postgres pgbackrest --stanza=litellm stanza-create
  fi
  compose exec -T --user postgres postgres pgbackrest --stanza=litellm check
  backup_run
  compose up -d --no-deps proxy
  wait_proxy
  success=1
  trap - EXIT
  printf 'LiteLLM is ready at http://127.0.0.1:4000/v1\n'
}

backup() {
  require_docker
  is_running postgres || { printf 'PostgreSQL is not running.\n' >&2; return 1; }
  resolve_backup_dir
  require_matching_backup_dir
  repository_has_metadata || { printf 'Backup repository is missing or incomplete.\n' >&2; return 1; }
  require_writable_backup_dir
  backup_run
}

status() {
  require_docker
  if is_running postgres; then
    LITELLM_BACKUP_DIR="$(running_backup_dir)" || return 1
    resolve_backup_dir
  else
    resolve_backup_dir
  fi
  local service state info summary
  for service in postgres proxy; do
    state="$(compose ps --format json "$service" 2>/dev/null | python3 -c 'import json,sys; s=sys.stdin.read().strip(); print(json.loads(s.splitlines()[0]).get("State", "stopped") if s else "stopped")')"
    printf '%s: %s\n' "$service" "$state"
  done
  printf 'Backup directory: %s\n' "$LITELLM_BACKUP_DIR"
  if is_running postgres; then
    repository_has_metadata || { printf 'Backup repository is missing or incomplete.\n' >&2; return 1; }
    info="$(backup_info)" || return 1
  else
    if repository_is_empty; then
      if live_volume_exists; then
        printf 'Backup repository is empty while the live database volume exists.\n' >&2
        return 1
      fi
      printf 'Latest backup: none none\n'
      return 0
    fi
    repository_has_metadata || { printf 'Backup repository is incomplete.\n' >&2; return 1; }
    if ! docker image inspect projectslatte/litellm-postgres:18.6-trixie-pgbackrest-2.55.1 >/dev/null 2>&1; then
      printf 'PostgreSQL image is absent. Run start to build it before reading backup metadata.\n' >&2
      return 1
    fi
    info="$(docker run --rm --volume "$LITELLM_BACKUP_DIR:/var/lib/pgbackrest:ro" \
      --entrypoint pgbackrest projectslatte/litellm-postgres:18.6-trixie-pgbackrest-2.55.1 \
      --stanza=litellm info --output=json)" || return 1
  fi
  summary="$(printf '%s' "$info" | backup_summary)" || return 1
  IFS='|' read -r backup_type backup_time backup_choice <<< "$summary"
  printf 'Latest backup: %s %s\n' "$backup_type" "$backup_time"
}

stop() {
  require_docker
  # Compose does not read the secret source values for down.
  compose down
}

restore_check() {
  require_docker
  resolve_backup_dir
  repository_has_metadata || { printf 'Backup repository is missing or incomplete.\n' >&2; return 1; }
  if is_running postgres; then
    require_matching_backup_dir
  fi
  "$project_dir/bin/restore-check" "$@"
}

case "${1:-}" in
  start)
    (( $# == 1 )) || { (( $# == 2 )) && [[ "$2" == --reinitialize-backup-repo ]] || usage; }
    acquire_lock
    if (( $# == 2 )); then start yes; else start no; fi ;;
  status) status ;;
  backup) acquire_lock; backup ;;
  stop) acquire_lock; stop ;;
  restore-check) acquire_lock; shift; restore_check "$@" ;;
  *) usage ;;
esac
