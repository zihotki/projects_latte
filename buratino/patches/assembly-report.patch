+def draft_mortise_panel_maps(cab_cfg, *, centered_face_rows: bool = False) -> dict[str, PanelMortiseMap]:
+    """Return draft perimeter maps; centered side rows are an explicit design choice.
+
+    Side coordinates are measured from the front edge. Render the left inner
+    face with front at left and the right inner face with front at right.
+    """
+    from dataclasses import replace
+    from .cabinet import CarcassJoinery
+
+    if (getattr(cab_cfg, "carcass_joinery", CarcassJoinery.FLOATING_TENON) != CarcassJoinery.FLOATING_TENON
+            or getattr(cab_cfg, "carcass_corner_style", "butt") != "butt"):
+        return {}
+    positions = _candidate_positions(float(cab_cfg.interior_depth), cab_cfg.domino_spec)
+    if not positions:
+        return {}
+    plan = build_assembly_plan(cab_cfg, domino_spec=cab_cfg.domino_spec,
+                               candidate_positions=positions)
+    maps = {}
+    for panel in plan.panels:
+        if panel.canonical in {"top", "bottom"}:
+            rows = tuple(row for row in panel.rows if row.kind == "edge")
+        elif panel.canonical == "side" and centered_face_rows:
+            bottom = float(cab_cfg.bottom_thickness) / 2
+            top = float(cab_cfg.height) - float(cab_cfg.top_thickness) / 2
+            rows = (MortiseRow("bottom", "h", bottom, positions, "face"),
+                    MortiseRow("top", "h", top, positions, "face"))
+        else:
+            continue
+        if rows:
+            maps[panel.canonical] = replace(panel, rows=rows, note="")
+    return maps
+
