+def generate_draft_mortise_maps(
+    cab_cfg, cabinet_name: str = "Cabinet", *, settings_supplied: bool = False
+) -> str:
+    """Render candidate carcass edge centers without machine setup claims.
+
+    The configured DominoSpec and native interior depth determine centers from
+    the back edge. Face registration, plunge depth and cutter settings remain
+    unknown. Only the perimeter top and bottom edge rows are displayed.
+    """
+    from dataclasses import replace
+    from html import escape
+    from .cabinet import CarcassJoinery
+
+    if getattr(cab_cfg, "carcass_joinery", CarcassJoinery.FLOATING_TENON) != CarcassJoinery.FLOATING_TENON:
+        return "<p>Candidate maps are unavailable for this joinery.</p>"
+    if getattr(cab_cfg, "carcass_corner_style", "butt") != "butt":
+        return "<p>Candidate maps are unavailable for mitered carcasses.</p>"
+    positions = _candidate_positions(float(cab_cfg.interior_depth), cab_cfg.domino_spec)
+    if not positions:
+        return "<p>Candidate maps are unavailable for this span and Domino spacing.</p>"
+    plan = build_assembly_plan(
+        cab_cfg, cabinet_name, domino_spec=cab_cfg.domino_spec,
+        candidate_positions=positions,
+    )
+    centers = ", ".join(f"{p:g}" for p in plan.positions)
+    out = [
+        f"<h3>{escape(cabinet_name)}</h3>",
+        "<p>Layout: calculated centers, not for machining. "
+        f"Domino {escape(plan.size_key)}, span {plan.span:g} mm; "
+        f"centers {centers} mm from the back edge. "
+        + ("Marks are schematic; slot length, fit and glue clearance need confirmation. "
+           "Confirm registration. " if settings_supplied else
+           "Marks are schematic; actual slot dimensions and clearance are unknown. "
+           "Confirm registration, depth, tool settings and fit. ")
+        + "Face-row offsets are not specified.</p>",
+    ]
+    for panel in plan.panels:
+        if panel.canonical not in {"bottom", "top"}:
+            continue
+        rows = tuple(row for row in panel.rows if row.kind == "edge")
+        if not rows:
+            continue
+        safe_panel = replace(panel, rows=rows, note="")
+        out.append(f"<h4>{escape(panel.panel)}</h4>")
+        out.append(_panel_svg(safe_panel, precise_ticks=True, reference_back=True))
+    return "\n".join(out)
+
