+def _candidate_positions(span: float, spec: DominoSpec) -> tuple[float, ...]:
+    """Place candidate centers on a 10 mm grid with nominal tenon clearance."""
+    if not math.isfinite(span) or not math.isfinite(spec.max_spacing) or spec.max_spacing <= 0:
+        return ()
+    size = spec.size
+    length = size.mortise_length if size.mortise_length is not None else size.nominal_width
+    clearance = max(40.0, size.min_edge_distance + length / 2)
+    first = math.ceil(clearance / 10)
+    last = math.floor((span - clearance) / 10)
+    if first > last:
+        return ()
+    distance = last - first
+    min_step = math.ceil(length / 10)
+    if distance < min_step:
+        # Choose the available grid point nearest the middle of the span.
+        center = min(last, max(first, math.floor(span / 20 + 0.5)))
+        return (float(center * 10),)
+    max_step = math.floor(spec.max_spacing / 10)
+    if max_step < min_step:
+        return ()
+    # Maximise coverage while keeping every interval within both limits.
+    # Some grid distances cannot be partitioned into legal intervals, so
+    # move the backmost center inward until a valid layout exists.
+    for covered in range(distance, min_step - 1, -1):
+        intervals = math.ceil(covered / max_step)
+        if covered // intervals >= min_step:
+            return tuple(float((first + (i * covered // intervals)) * 10)
+                         for i in range(intervals + 1))
+    return ()
+
