{
  "name": "@cut-on-eight/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx src/catalog/migrate.ts",
    "search:rebuild": "tsx --import ./src/observability/instrumentation.ts src/search/rebuild-semantic-search-main.ts",
    "search:smoke": "vitest run test/qdrant-smoke.test.ts",
    "events:replay": "tsx --import ./src/observability/instrumentation.ts src/events/replay-command.ts",
    "dev:relay": "tsx --import ./src/observability/instrumentation.ts src/events/relay.ts",
    "dev:search-indexer": "tsx --import ./src/observability/instrumentation.ts src/search/search-indexer-main.ts",
    "dev:thumbnails-service": "tsx --import ./src/observability/instrumentation.ts src/thumbnails-service.ts",
    "dev": "tsx watch --import ./src/observability/instrumentation.ts src/server.ts",
    "dev:worker": "tsx watch --import ./src/observability/instrumentation.ts src/worker.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude 'test/*integration*.test.ts' --exclude 'test/catalog-database.test.ts' --exclude 'test/editor-fragment-api.test.ts' --exclude 'test/video-workspace-api.test.ts' --exclude 'test/qdrant-smoke.test.ts'",
    "test:integration": "vitest run --no-file-parallelism test/catalog-database.test.ts test/editor-fragment-api.test.ts test/health-integration.test.ts test/video-workspace-api.test.ts test/worker-media-integration.test.ts test/qdrant-smoke.test.ts test/hybrid-qdrant-store.integration.test.ts test/semantic-search-event.integration.test.ts"
  },
  "dependencies": {
    "@cut-on-eight/api-contracts": "workspace:*",
    "@cut-on-eight/legacy-contracts": "workspace:*",
    "@fastify/multipart": "^9.4.0",
    "@fastify/otel": "^0.20.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "cockatiel": "^4.0.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
