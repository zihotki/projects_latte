{
  "name": "@cut-on-eight/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "tsx src/catalog/migrate.ts",
    "dev": "tsx watch --import ./src/observability/instrumentation.ts src/server.ts",
    "dev:worker": "tsx watch --import ./src/observability/instrumentation.ts src/worker.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude 'test/*integration*.test.ts' --exclude 'test/catalog-database.test.ts' --exclude 'test/editor-fragment-api.test.ts' --exclude 'test/video-workspace-api.test.ts'",
    "test:integration": "vitest run test/catalog-database.test.ts test/editor-fragment-api.test.ts test/health-integration.test.ts test/video-workspace-api.test.ts test/worker-media-integration.test.ts"
  },
  "dependencies": {
    "@cut-on-eight/api-contracts": "workspace:*",
    "@cut-on-eight/legacy-contracts": "workspace:*",
    "@fastify/multipart": "^9.3.0",
    "@fastify/otel": "^0.20.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "cockatiel": "^4.0.0",
    "fastify": "^5.10.0",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1"
  }
}
