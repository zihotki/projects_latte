# PostgreSQL is managed outside this Compose stack. Use a host that containers can reach.
DATABASE_URL=postgresql://cut_on_eight:change-me@postgres-host:5432/cut_on_eight
# The exact browser origin. Put authentication and TLS at the host reverse proxy.
CUT_ON_EIGHT_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Absolute host directories. Keep source media and thumbnails on persistent storage.
CUT_ON_EIGHT_MEDIA_DIR=/srv/cut-on-eight/media
CUT_ON_EIGHT_THUMBNAILS_DIR=/srv/cut-on-eight/thumbnails
# Match the owner of these two host directories.
CUT_ON_EIGHT_UID=1000
CUT_ON_EIGHT_GID=1000
